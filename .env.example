# 通用配置
ENVIRONMENT=development

# web服务配置
WEB_APP_NAME=渡一web服务
WEB_API_PREFIX=/api

# 跨域配置
WEB_CORS_ORIGINS=*
WEB_CORS_ALLOW_METHODS=*
WEB_CORS_ALLOW_HEADERS=*
WEB_CORS_EXPOSE_HEADERS=X-Process-Time,X-Request-ID
WEB_CORS_ALLOW_CREDENTIALS=false
WEB_CORS_MAX_AGE=600

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tm_db
DB_USER=admin
DB_PASSWORD=123123
DB_ECHO=false

# 日志配置
LOG_LEVEL=INFO

# 阿里云 OSS 配置（文件上传）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# 上传凭证有效期（秒）
OSS_EXPIRE_SECONDS=3600
# 允许上传的 MIME 类型，逗号分隔；留空表示不限制
OSS_MIME_TYPES=image/png,image/jpeg,image/webp,application/pdf
# 存储目录策略：date（uploads/YYYY/MM/DD/）或 flat（uploads/）
OSS_DIR_STRATEGY=date
