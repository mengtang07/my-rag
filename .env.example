# 通用配置
ENVIRONMENT=development

# web服务配置
WEB_APP_NAME=my-rag API

# 跨域配置
WEB_CORS_ORIGINS=*
WEB_CORS_ALLOW_METHODS=*
WEB_CORS_ALLOW_HEADERS=*
WEB_CORS_EXPOSE_HEADERS=X-Process-Time,X-Request-ID
WEB_CORS_ALLOW_CREDENTIALS=false
WEB_CORS_MAX_AGE=600

# 数据库配置（docker compose 映射到宿主 5433，避开本机已被占用的 5432）
DB_HOST=localhost
DB_PORT=5433
DB_NAME=rag_db
DB_USER=admin
DB_PASSWORD=123123
DB_ECHO=false

# Milvus 向量库配置
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=rag_chunks
# 必须与网关 embedding 模型的实际维度一致（text-embedding 实测为 1024）
MILVUS_EMBED_DIM=1024
MILVUS_SEARCH_EF=64
MILVUS_BATCH_SIZE=500
MILVUS_TIMEOUT=30

# LiteLLM 网关配置（复用本机已有的网关）
LLM_API_BASE=http://localhost:4000
LLM_API_KEY=
LLM_CHAT_MODEL=chat-standard
LLM_EMBED_MODEL=text-embedding
LLM_RERANK_MODEL=rerank
LLM_EMBED_BATCH_SIZE=32
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_CONTEXT_WINDOW=32000

# 检索增强配置
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_MIN_CHARS=80
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=6000
RAG_HISTORY_TURNS=6
RAG_MAX_FILE_MB=20
RAG_USE_RERANK=false

# 钉钉知识库配置
# appKey / appSecret 来自钉钉开放平台的企业内部应用
# operator_id 必须是用户的 unionId（不是 userId），拿错了接口会报权限错误
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_OPERATOR_ID=
# 留空则默认取第一个可见的知识库
DINGTALK_WORKSPACE_ID=
DINGTALK_BASE_URL=https://api.dingtalk.com
DINGTALK_TIMEOUT=30

# 日志配置
LOG_LEVEL=INFO
