# 测试环境变量样例：复制为 .env.test 后生效
# .env.test 只被测试代码读取（test/e2e、packages/duyi-utils 的 OSS 集成测试），
# 不会影响开发环境的 .env

# 数据库（PostgreSQL，e2e 测试用）
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=123123

# 阿里云 OSS（真实上传集成测试需要，缺失时相关用例会跳过）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
