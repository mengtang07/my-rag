# 测试环境变量样例：复制为 .env.test 后生效
# .env.test 只被测试代码读取（e2e 测试），不会影响开发环境的 .env

# 数据库（PostgreSQL，e2e 测试用；库名必须以 _test 结尾）
DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=123123

# Milvus（集成测试用；测试集合名带 _test 后缀，避免污染开发集合）
MILVUS_URI=http://localhost:19530

# LiteLLM 网关（e2e 真实调用需要；缺失时相关用例会跳过）
LLM_API_BASE=http://localhost:4000
LLM_API_KEY=
